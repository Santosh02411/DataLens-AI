# Copy this file to backend/.env and fill in ONE provider key.
# The app runs without any key: data health, suggested analyses and the
# analysis builder all work. A key only enables typed natural-language questions.

# anthropic | openai | gemini | none. Leave empty to auto-detect from the keys below.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the provider's default model.
# Defaults: anthropic=claude-haiku-5-5, openai=gpt-4.1-mini, gemini=gemini-2.5-flash
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Optional: send requests to a compatible gateway/proxy instead of the provider's public API
LLM_BASE_URL=

# Upload safeguards
MAX_UPLOAD_MB=25
MAX_ROWS=500000
MAX_COLUMNS=200
MAX_DATASETS_IN_MEMORY=10

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
