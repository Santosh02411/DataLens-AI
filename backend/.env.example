# Copy this file to backend/.env and add your Gemini key (free: https://aistudio.google.com/apikey).
# The app runs without any key: data health, insights, the dashboard, suggested analyses, what-if,
# the builder and the benchmark all work. A key enables typed natural-language questions and
# optional plain-English explanations of insights.

# gemini (recommended) | openai | anthropic | none. Leave empty to auto-detect (Gemini is preferred).
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model. Any current Gemini Flash model works, e.g. gemini-2.5-flash or gemini-2.5-flash-lite.
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
# Optional: send requests to a compatible gateway/proxy instead of the provider's public API
LLM_BASE_URL=

# Protect your key on a public deployment (0 disables a limit)
AI_RATE_PER_MINUTE=8
AI_DAILY_LIMIT=300
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Fly, Nginx) so limits apply per visitor
TRUST_PROXY=0

# Upload safeguards
MAX_UPLOAD_MB=25
MAX_ROWS=500000
MAX_COLUMNS=200
MAX_DATASETS_IN_MEMORY=10

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
